# ---------------------------------------------------------------------------
# Өгөгдлийн сан — Neon (үнэгүй tier)
#   https://console.neon.tech → шинэ project → Connection string
#   "Pooled connection" биш, ЭНГИЙН connection string-ийг ав (HTTP драйвер).
# ---------------------------------------------------------------------------
POSTGRES_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Зургийн хадгалалт — Cloudflare R2 (10 GB үнэгүй, egress төлбөргүй)
#   Phase 2-оос хэрэгтэй болно. Phase 0-д хоосон байж болно.
# ---------------------------------------------------------------------------
#   Локал тест: docker compose up -d && npm run storage:init
#   тэгээд доорх R2_ENDPOINT-ийг тайлбараас гаргана.
# R2_ENDPOINT=http://localhost:9100
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hotel-survey-photos
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Нэвтрэлт — Phase 1-ээс хэрэгтэй
#   Үүсгэх:  openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# Экспорт — Phase 6-аас хэрэгтэй. Hotel SaaS энэ түлхүүрээр lead татна.
# ---------------------------------------------------------------------------
EXPORT_API_KEY=

# ---------------------------------------------------------------------------
# OSM үйлчилгээ — Phase 3-аас хэрэгтэй
#   Nominatim нь User-Agent дотор ХОЛБОО БАРИХ мэдээлэл шаарддаг. Үүнгүй бол
#   IP хоригдоно. API түлхүүр байхгүй — зөвхөн энэ мөр.
# ---------------------------------------------------------------------------
GEO_USER_AGENT=HotelFieldSurvey/1.0 (zorigtchristian0721@gmail.com)
